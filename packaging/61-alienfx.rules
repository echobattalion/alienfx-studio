# Alienware / Dell AlienFX lighting devices - grant access to the local user.
# Darfon RGB keyboard (Alienware x17 R1 per-key backlight)
SUBSYSTEMS=="usb|hidraw", ATTRS{idVendor}=="0d62", ATTRS{idProduct}=="babc", TAG+="uaccess"
# Alienware AW-ELC light bars / alien head / touchpad / power button
SUBSYSTEMS=="usb|hidraw", ATTRS{idVendor}=="187c", ATTRS{idProduct}=="0550", TAG+="uaccess"
